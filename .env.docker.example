# Copie para .env antes de: docker compose --env-file .env up --build
# Ou exporte as variáveis no shell.

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Pasta no host com os CSVs da Byst.end (montada em /app/data/csvs no container da API)
CSV_HOST_PATH=./data

# Popula o banco automaticamente quando estiver vazio (recomendado)
SEED_IF_EMPTY=true

# true força re-seed a cada subida (destrutivo — apaga dados existentes)
SEED_ON_START=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
